# Exercises the plugins and global options the real config depends on.
{
	order rate_limit before basic_auth
	dns bunny {env.BUNNY_API_KEY}
	acme_dns bunny {env.BUNNY_API_KEY}
	ech ech.example.com
	cert_issuer acme {
		profile shortlived
	}
}

example.com {
	rate_limit {
		zone test {
			key {remote_host}
			events 10
			window 1m
		}
	}
	respond "ok"
}

bunny.example.com {
	tls {
		dns bunny {env.BUNNY_API_KEY}
	}
	respond "ok"
}
