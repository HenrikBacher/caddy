# Exercises the plugins and global options the real config depends on.
{
	order rate_limit before basic_auth
	dns desec {
		token {env.DESEC_TOKEN}
	}
	acme_dns desec {
		token {env.DESEC_TOKEN}
	}
	ech ech.example.com
	cert_issuer acme {
		profile shortlived
	}
}

example.com {
	rate_limit {
		zone test {
			key {remote_host}
			events 10
			window 1m
		}
	}
	respond "ok"
}

desec.example.com {
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}
	}
	respond "ok"
}
